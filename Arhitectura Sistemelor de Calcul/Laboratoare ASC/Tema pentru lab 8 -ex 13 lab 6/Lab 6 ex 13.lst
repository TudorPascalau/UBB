     1                                  bits 32
     2                                  
     3                                  global start        
     4                                  
     5                                  extern exit               
     6                                  import exit msvcrt.dll    
     7                                  
     8                                  ;Se da un sir S de dublucuvinte.
     9                                  ;Sa se obtina sirul D format din octetii inferiori ai cuvintelor inferioare din elementele sirului de dublucuvinte, care sunt multiplii de 7.
    10                                  
    11                                  segment data use32 class=data
    12                                      
    13 00000000 07563412153C2B1A12-         s dd 12345607h, 1a2b3c15h, 13a33312h
    13 00000009 33A313             
    14                                      len equ ($-s)/4
    15                                      
    16 0000000C 00<rept>                    d times len db 0
    17                                      
    18 0000000F 07                          sapte db 7
    19                                  
    20                                  segment code use32 class=code
    21                                      start:
    22                                      
    23 00000000 B903000000                      mov ecx, len
    24 00000005 E325                            jecxz final
    25                                  
    26 00000007 BE[00000000]                    mov esi, s
    27 0000000C BF[0C000000]                    mov edi, d
    28 00000011 FC                              cld
    29                                          
    30                                          repeta:
    31                                          
    32 00000012 66AD                                lodsw ; in ax vom avea cuvantul inferior al dublucuvantului curent
    33 00000014 6625FF00                            and ax, 00ffh ; pastram doar octetul inferior
    34 00000018 88C3                                mov bl, al ; salvam octetul inferior
    35                                              
    36 0000001A F635[0F000000]                      div byte[sapte] ; in ah avem restul impartirii
    37 00000020 80FC00                              cmp ah, 0 ; verificam multiplu al lui 7
    38 00000023 7503                                jnz nonmultiplu
    39                                              
    40 00000025 88D8                                mov al, bl ; punem la loc octetul inferior
    41 00000027 AA                                  stosb
    42                                          
    43                                              nonmultiplu:
    44 00000028 66AD                                lodsw ; incarcam octetul superior al dublucuvantului curent
    45 0000002A E2E6                                loop repeta
    46                                          
    47                                          final:
    48 0000002C 6A00                                push    dword 0      
    49 0000002E FF15[00000000]                      call    [exit]       
