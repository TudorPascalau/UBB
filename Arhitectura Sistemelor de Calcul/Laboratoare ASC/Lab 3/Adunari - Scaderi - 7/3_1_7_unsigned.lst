     1                                  bits 32
     2                                  
     3                                  global start        
     4                                  
     5                                  extern exit               
     6                                  import exit msvcrt.dll    
     7                                  
     8                                  ; c - (d+d+d) + (a-b) - Interpretare fara semn
     9                                  
    10                                  
    11                                  segment data use32 class=data
    12                                      ; a - byte
    13                                      ; b - word
    14                                      ; c - dword
    15                                      ; d - qword
    16                                      
    17 00000000 0A                          a db 10
    18 00000001 0500                        b dw 5
    19 00000003 14000000                    c dd 20
    20 00000007 0400000000000000            d dq 4
    21                                  
    22                                  
    23                                  segment code use32 class=code
    24                                      start:
    25                                      
    26                                          ; c
    27 00000000 A1[03000000]                    mov eax, [c]
    28 00000005 BA00000000                      mov edx, 0 ; EDX:EAX = c (=20)
    29                                          
    30                                          ; d+d+d
    31 0000000A 8B1D[07000000]                  mov ebx, dword [d]
    32 00000010 8B0D[0B000000]                  mov ecx, dword [d+4] ; ECX:EBX = d (=4)
    33                                          
    34 00000016 031D[07000000]                  add ebx, [d]
    35 0000001C 130D[0B000000]                  adc ecx, [d+4]
    36                                          
    37 00000022 031D[07000000]                  add ebx, [d]
    38 00000028 130D[0B000000]                  adc ecx, [d+4] ; ECX:EBX = d+d+d (=12)
    39                                          
    40                                          ; c - (d+d+d)
    41 0000002E 29D8                            sub eax, ebx
    42 00000030 19CA                            sbb edx, ecx ; EDX:EAX = c - (d+d+d) (=8)
    43                                          
    44                                          ; a-b
    45 00000032 BB00000000                      mov ebx, 0
    46 00000037 8A1D[00000000]                  mov bl, [a]
    47 0000003D B700                            mov bh, 0 ; BX = a (=10)
    48 0000003F 662B1D[01000000]                sub bx, [b]; EBX = BX = a-b (5)
    49                                  
    50                                          ;c - (d+d+d) + (a-b)
    51 00000046 01D8                            add eax, ebx
    52 00000048 83D200                          adc edx, 0 ;EDX:EAX = c - (d+d+d) + (a-b) (=13)
    53                                          
    54 0000004B 6A00                            push    dword 0      
    55 0000004D FF15[00000000]                  call    [exit]       
