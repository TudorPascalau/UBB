<Group hide-input="false" labelreference="L61" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Exercitiul 4)
restart;
with(DEtools):
with(plots):
with(linalg):
ec1:=diff(x(t),t)=y(t);
ec2:=diff(y(t),t)=2*x(t)^3+x(t)^2-x(t);
sist:=ec1,ec2;
# a)
f1:=(x,y)-&gt;y;
f2:=(x,y)-&gt;2*x^3+x^2-x;
PctEch:=solve({f1(x,y)=0,f2(x,y)=0},{x,y});
# b)
J:=jacobian([f1(x,y),f2(x,y)],[x,y]);
A1:=subs(PctEch[1,1],PctEch[1,2],eval(J));
eigenvals(A1);
A2:=subs(PctEch[2,1],PctEch[2,2],eval(J));
eigenvals(A2);
A3:=subs(PctEch[3,1],PctEch[3,2],eval(J));
eigenvals(A3);
# Vreau sa vizualizez punctele de echilibru
cond_in:=seq(seq([x(0)=i,y(0)=j],i=-3..3),j=-3..3);
DEplot([sist],[x(t),y(t)],t=-10..10,x=-3..3,y=-3..3, [cond_in],linecolor=blue,stepsize=0.1);
</Text-field>
</Input>
