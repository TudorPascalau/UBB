# b)
J:=jacobian([f1(x,y),f2(x,y)],[x,y]);
A1:=subs(PctEch[1,1],PctEch[1,2],eval(J));
eigenvals(A1);
# Punct nod stabil
A2:=subs(PctEch[2,1],PctEch[2,2],eval(J));
eigenvals(A2);
# Punct sa instabil
cond_in:=seq(seq([x(0)=i,y(0)=j],i=-3..3),j=-3..3);
DEplot([ec1,ec2],[x(t),y(t)],t=-10..10,x=-3..3,y=-3..3, [cond_in],linecolor=blue,stepsize=0.1);</Text-field>
</Input>
