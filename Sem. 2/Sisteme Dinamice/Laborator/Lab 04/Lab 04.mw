<Group hide-input="false" labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Laboratorul 4
# Exercitiul 1) Se considera modelul dezintegrarii radioactive
restart;
with(DEtools):
with(plots):
ec:=diff(x(t),t)=-k*x(t);
cond:=x(0)=x0;
# a) Rezolvati problema Cauchy
sol:=dsolve({ec,cond},x(t));</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+SSNlY0dGKC8tSSVkaWZmR0YmNiQtSSJ4R0YoNiNJInRHRihGNSwkKiZJImtHRigiIiJGMkY5ISIiNyNGLg==</Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+SSVjb25kR0YoLy1JInhHRig2IyIiIUkjeDBHRig3I0Yu</Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+SSRzb2xHRigvLUkieEdGKDYjSSJ0R0YoKiZJI3gwR0YoIiIiLUkkZXhwR0YlNiMsJComSSJrR0YoRjVGMkY1ISIiRjU3I0Yu</Equation></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L2" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># b) Reprezentati grafic cateva solutii
xx:=unapply(rhs(sol),t,x0,k);
plot([xx(t,100,0.1),xx(t,100,0.05),xx(t,100,0.01)], t=0..50);</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+SSN4eEdGKGYqNiVJInRHRihJI3gwR0YoSSJrR0YoRig2JEkpb3BlcmF0b3JHRihJJmFycm93R0YoRigqJjklIiIiLUkkZXhwR0YlNiMsJComOSZGODkkRjghIiJGOEYoRihGKDcjRi4=</Equation></Text-field>
</Output>
<Output><Text-field style="Maple Plot" layout="Maple Plot"><Plot height="500.0" originalheight="500.0" type="two-dimensional" width="500.0" originalwidth="500.0" plot-scale="1.0" plot-xtrans="0.0" plot-ytrans="0.0" gridlinevisibility="1" legendvisibility="false" input="_ATTRIBUTE(&quot;input&quot; = [TABLE([1 = plot, 2 = [100*exp(-.1*t), 100*exp(-0.5e-1*t), 100*exp(-0.1e-1*t)], 3 = (t = 0 .. 50)]), &quot;originalview&quot; = [.125000000000000000 .. 49.8750000000000000, .682269993900000093 .. 99.8750780900000024], &quot;originalaxesticks&quot; = AXESTICKS(DEFAULT, DEFAULT, _ATTRIBUTE(&quot;source&quot; = &quot;mathdefault&quot;))])"></Plot></Text-field>
</Output>
</Group>
<Group hide-input="false" labelreference="L10" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># c) Stiind ca timpul de injumatatire t1/2 = 5730 sa se determine constanta k
# =&gt; xx(t1/2, x0, k) = x0/2
kC14:=solve(xx(5730,1,k)=0.5);
</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">LV9JLFR5cGVzZXR0aW5nRzYkJSpwcm90ZWN0ZWRHSShfc3lzbGliRzYiSSxtcHJpbnRzbGFzaEdGKDYkNyM+SSVrQzE0R0YoJCIrVjRvNDchIzg3I0Yu</Equation></Text-field>
