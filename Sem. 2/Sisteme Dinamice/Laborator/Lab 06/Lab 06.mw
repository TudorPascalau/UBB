<Group hide-input="false" labelreference="L234" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># b)
restart;
with(DEtools):
with(plots):
with(linalg):
f1:=(x,y)-&gt;-2*x+y+2;
f2:=(x,y)-&gt;x*y;
ec1:=diff(x(t),t)=-2*x(t)+y(t)+2;
ec2:=diff(y(t),t)=x(t)*y(t);
sist:=ec1,ec2;
PctEch:=solve({f1(x,y)=0,f2(x,y)=0},{x,y});
J:=jacobian([f1(x,y),f2(x,y)],[x,y]);
A1:=subs(PctEch[1,1],PctEch[1,2],eval(J));
eigenvals(A1);
# Punct de tip sa instabil
A2:=subs(PctEch[2,1],PctEch[2,2],eval(J));
eigenvals(A2);
# Punct de tip focus stabil
cond_in:=seq(seq([x(0)=i,y(0)=j],i=-3..3),j=-3..3);
DEplot([sist],[x(t),y(t)],t=-10..10,x=-3..3,y=-3..3, [cond_in],linecolor=blue,stepsize=0.1);</Text-field>
</Input>
