<Group hide-input="false" labelreference="L404" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># b) Determinati punctele de echilibru si stabilitatea acestora
with(linalg):
f1:=(x,y)-&gt;2*x-1.2*x*y;
f2:=(x,y)-&gt;-y+0.9*x*y;
PctEch:=solve({f1(x,y)=0,f2(x,y)=0},{x,y}, real);
J:=jacobian([f1(x,y),f2(x,y)],[x,y]);
A1:=subs(PctEch[1,1],PctEch[1,2],eval(J));
eigenvals(A1);
# Punct de instabil
A2:=subs(PctEch[2,1],PctEch[2,2],eval(J));
eigenvals(A2);
# Punct stabil</Text-field>
</Input>
