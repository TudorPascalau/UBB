ec2:=diff(y(t),t)=x(t);
sist:=ec1,ec2;
PctEch:=solve({f1(x,y)=0,f2(x,y)=0},{x,y});
J:=jacobian([f1(x,y),f2(x,y)],[x,y]);
A1:=subs(PctEch[1],PctEch[2],eval(J));
eigenvals(A1);
# Punct degenerat =&gt; dupa desen pare instabil
cond_in:=seq(seq([x(0)=i,y(0)=j],i=-3..3),j=-3..3);
DEplot([sist],[x(t),y(t)],t=-10..10,x=-3..3,y=-3..3, [cond_in],linecolor=blue,stepsize=0.1);</Text-field>
</Input>
