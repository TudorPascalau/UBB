<Group hide-input="false" labelreference="L2" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Exercitiul 1) Determinati solutiile generale si reprezentati solutii
# a)
ec1a:=diff(y(x),x)=2*x*(1+y(x)^2);
sol1a:=dsolve(ec1a,y(x));
y1a:=unapply(rhs(sol1a),x,_C1);
plot([y1a(x,0),y1a(x,1),y1a(x,-1)],x=-2..2);</Text-field>
</Input>
