     1                                  bits 32
     2                                  
     3                                  global start        
     4                                  
     5                                  extern exit               
     6                                  import exit msvcrt.dll    
     7                                  
     8                                  ; Se dau doua siruri de octeti S1 si S2 de aceeasi lungime. 
     9                                  ; Sa se obtina sirul D prin intercalarea elementelor celor doua siruri
    10                                  
    11                                  segment data use32 class=data
    12                                  
    13 00000000 01030507                    s1 db 1,3,5,7
    14                                      len1 equ $-s1
    15                                      
    16 00000004 02040608                    s2 db 2,4,6,8
    17                                      len2 equ $-s2
    18                                      
    19 00000008 00<rept>                    d times len1+len2 db 0
    20                                  
    21                                  
    22                                  segment code use32 class=code
    23                                      start:
    24                                          
    25                                          ; formam indicii pari ai sirului a sirului
    26 00000000 B904000000                      mov ecx, len1
    27 00000005 BE00000000                      mov esi, 0
    28 0000000A BF00000000                      mov edi, 0
    29 0000000F E335                            jecxz Sfarsit
    30                                          Repeta1:
    31                                          
    32 00000011 8A86[00000000]                      mov al, [s1+esi]
    33 00000017 8887[08000000]                      mov [d+edi], al
    34 0000001D 46                                  inc esi
    35 0000001E 83C702                              add edi, 2
    36                                              
    37 00000021 E2EE                            loop Repeta1
    38                                              
    39                                          ; formam indicii impari ai sirului
    40 00000023 B904000000                      mov ecx, len2
    41 00000028 BE00000000                      mov esi, 0
    42 0000002D BF01000000                      mov edi, 1
    43 00000032 E312                            jecxz Sfarsit
    44                                          Repeta2:
    45                                          
    46 00000034 8A86[04000000]                      mov al, [s2+esi]
    47 0000003A 8887[08000000]                      mov [d+edi], al
    48 00000040 46                                  inc esi
    49 00000041 83C702                              add edi, 2
    50                                              
    51 00000044 E2EE                            loop Repeta2
    52                                              
    53                                          Sfarsit:
    54                                          
    55 00000046 6A00                            push    dword 0      
    56 00000048 FF15[00000000]                  call    [exit]       
