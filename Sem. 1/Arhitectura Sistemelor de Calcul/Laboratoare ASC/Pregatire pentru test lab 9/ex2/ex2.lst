     1                                  bits 32
     2                                  
     3                                  global start        
     4                                  
     5                                  extern exit, fopen, fprintf, fclose, scanf
     6                                  import exit msvcrt.dll    
     7                                  import fopen msvcrt.dll
     8                                  import fprintf msvcrt.dll
     9                                  import fclose msvcrt.dll
    10                                  import scanf msvcrt.dll
    11                                  
    12                                  ; Se citesc numere de la tastatura pana cand se introduce numarul 0
    13                                  ; Toate numerele care sunt palindrom vor fi scrise in fisierul palindrom.txt, separate prin spatiu, urmate de toate care nu sunt palindrom
    14                                  ; La tastatura se vor introduce cel mult 100 de numere
    15                                  
    16                                  segment data use32 class=data
    17                                      
    18 00000000 <res 00000190>                  d resd 100
    19 00000190 FFFFFFFF                        a dd -1
    20 00000194 256400                          format_citire db "%d", 0
    21                                          
    22 00000197 70616C696E64726F6D-             nume_fisier db "palindrom.txt", 0
    22 000001A0 2E74787400         
    23 000001A5 7700                            mod_acces db "w", 0
    24 000001A7 FFFFFFFF                        descriptor dd -1
    25                                          
    26 000001AB 256400                          format_numar db "%d", 0
    27 000001AE 256300                          format_spatiu db "%c", 0
    28 000001B1 20                              s db " "
    29                                  
    30                                  segment code use32 class=code
    31                                      start:
    32                                      
    33 00000000 FC                              cld
    34 00000001 BF[00000000]                    mov edi, d ; in sirul d punem nepalindrom
    35 00000006 BE00000000                      mov esi, 0 ; contor numere nepalindrom
    36                                      
    37 0000000B 68[A5010000]                    push dword mod_acces ; deschidem fisierul
    38 00000010 68[97010000]                    push dword nume_fisier
    39 00000015 FF15[00000000]                  call [fopen]
    40 0000001B 83C408                          add esp, 4*2
    41                                          
    42 0000001E 83F800                          cmp eax, 0 ; verificam deschiderea
    43 00000021 0F84ED000000                    je final
    44 00000027 A3[A7010000]                    mov [descriptor], eax ; salvam descriptorul
    45                                          
    46                                      
    47 0000002C B964000000                      mov ecx, 100 ; pregatim citirea
    48                                          citeste:
    49 00000031 51                                  push ecx
    50 00000032 68[90010000]                        push dword a
    51 00000037 68[94010000]                        push dword format_citire
    52 0000003C FF15[00000000]                      call [scanf]
    53 00000042 59                                  pop ecx
    54 00000043 83C408                              add esp, 4*2
    55                                              
    56 00000046 833D[90010000]00                    cmp dword [a], 0
    57 0000004D 7479                                je termina_citire
    58                                              
    59 0000004F 51                                  push ecx ; salvam contor bucla
    60                                              
    61 00000050 A1[90010000]                        mov eax, [a]
    62 00000055 89C3                                mov ebx, eax ; copie
    63 00000057 BD00000000                          mov ebp, 0 ; creem oglinditul
    64                                              
    65                                              oglindit:
    66 0000005C 83F800                                  cmp eax, 0
    67 0000005F 741A                                    je ogl_gata
    68                                                  
    69 00000061 BA00000000                              mov edx, 0 ; edx:eax = eax
    70 00000066 B90A000000                              mov ecx, 10
    71 0000006B F7F1                                    div ecx ; eax = eax/10 ; edx = edx%10
    72                                                  
    73 0000006D 50                                      push eax ; salvam eax
    74 0000006E 52                                      push edx ; salvam restul
    75                                                  
    76 0000006F 89E8                                    mov eax, ebp ; eax = ecx
    77 00000071 F7E1                                    mul ecx ; edx:eax = eax*10 = ecx*10
    78 00000073 89C5                                    mov ebp, eax ; ebp = oglindit = ecx*10
    79                                                  
    80 00000075 5A                                      pop edx ; reluam restul
    81 00000076 01D5                                    add ebp, edx ; ecx = ecx*10 + 5
    82                                                  
    83 00000078 58                                      pop eax ; revenim la eax
    84                                                  
    85 00000079 EBE1                                    jmp oglindit
    86                                                  
    87                                              ogl_gata:
    88                                              
    89 0000007B 39EB                                cmp ebx, ebp
    90 0000007D 7402                                je palindrom
    91 0000007F 7538                                jne not_palindrom
    92                                              
    93                                              palindrom:
    94 00000081 51                                      push ecx
    95 00000082 FF35[90010000]                          push dword [a]
    96 00000088 68[AB010000]                            push dword format_numar
    97 0000008D FF35[A7010000]                          push dword [descriptor]
    98 00000093 FF15[00000000]                          call [fprintf]
    99 00000099 83C40C                                  add esp, 4*3
   100                                                  
   101 0000009C FF35[B1010000]                          push dword [s]
   102 000000A2 68[AE010000]                            push dword format_spatiu
   103 000000A7 FF35[A7010000]                          push dword [descriptor]
   104 000000AD FF15[00000000]                          call [fprintf]
   105 000000B3 83C40C                                  add esp, 4*3
   106 000000B6 59                                      pop ecx
   107                                                  
   108 000000B7 EB07                                    jmp revenire
   109                                                  
   110                                              not_palindrom:
   111 000000B9 A1[90010000]                            mov eax, [a]
   112 000000BE AB                                      stosd
   113 000000BF 46                                      inc esi
   114                                              
   115                                              revenire:
   116 000000C0 59                                  pop ecx
   117 000000C1 49                                  dec ecx
   118 000000C2 0F8569FFFFFF                        jnz citeste
   119                                              
   120                                          termina_citire:
   121                                          
   122 000000C8 89F1                            mov ecx, esi ; lungimea sirului de nepalindrom
   123 000000CA BE[00000000]                    mov esi, d
   124 000000CF E334                            jecxz inchide
   125                                          
   126                                          repeta_nonpal:
   127 000000D1 AD                                  lodsd ; EAX = dublucuvant din d
   128                                              
   129 000000D2 51                                  push ecx
   130                                              
   131 000000D3 50                                  push eax
   132 000000D4 68[AB010000]                        push dword format_numar
   133 000000D9 FF35[A7010000]                      push dword [descriptor]
   134 000000DF FF15[00000000]                      call [fprintf]
   135 000000E5 83C40C                              add esp, 4*3
   136                                              
   137 000000E8 FF35[B1010000]                      push dword [s]
   138 000000EE 68[AE010000]                        push dword format_spatiu
   139 000000F3 FF35[A7010000]                      push dword [descriptor]
   140 000000F9 FF15[00000000]                      call [fprintf]
   141 000000FF 83C40C                              add esp, 4*3
   142                                              
   143 00000102 59                                  pop ecx
   144                                              
   145 00000103 E2CC                                loop repeta_nonpal
   146                                          
   147                                          inchide:
   148                                          
   149 00000105 FF35[A7010000]                  push dword [descriptor]
   150 0000010B FF15[00000000]                  call [fclose]
   151 00000111 83C404                          add esp, 4
   152                                          
   153                                          final:
   154                                          
   155 00000114 6A00                            push    dword 0      
   156 00000116 FF15[00000000]                  call    [exit]       
