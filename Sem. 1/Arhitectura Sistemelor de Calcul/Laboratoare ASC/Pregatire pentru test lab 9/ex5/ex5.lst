     1                                  bits 32
     2                                  
     3                                  global start        
     4                                  
     5                                  extern exit, printf, scanf, fopen, fprintf, fclose   
     6                                  import exit msvcrt.dll
     7                                  import printf msvcrt.dll
     8                                  import scanf msvcrt.dll
     9                                  import fopen msvcrt.dll
    10                                  import fprintf msvcrt.dll
    11                                  import fclose msvcrt.dll
    12                                  
    13                                  ; Se da in data segment un sir de exact 10 caractere
    14                                  ; Sa se citeasca un numar natural n reprezentat pe un octet (daca se introduce o valoare mai mare programul va afisa un mesaj coresp si se va opri din executie)
    15                                  ; Sa cere sa se creeze n fisiere, fiecare avand numele output-i.txt, unde i=0,n
    16                                  ; Sa se scrie in fiecare fisier primele (i+1) caractere din sirul dat (sau maxim 10)
    17                                  
    18                                  segment data use32 class=data
    19                                      
    20 00000000 616263646566676869-         sir db "abcdefghij"
    20 00000009 6A                 
    21 0000000A 6F7574707574                output db "output"
    22 00000010 00<rept>                    destinatie times 10 db 0
    23                                      
    24 0000001A 6E2065737465206D61-         mesaj db "n este mai mare decat un octet" , 0
    24 00000023 69206D617265206465-
    24 0000002C 63617420756E206F63-
    24 00000035 74657400           
    25                                      
    26 00000039 00000000                    n dd 0
    27 0000003D 256400                      format_citire db "%d", 0
    28                                      
    29 00000040 00<rept>                    nume_fisier times 20 db 0
    30 00000054 7700                        mod_acces db "w", 0
    31 00000056 00000000                    descriptor dd 0
    32                                  
    33                                  segment code use32 class=code
    34                                  
    35                                      not_octet:
    36 00000000 68[1A000000]                    push dword mesaj
    37 00000005 FF15[00000000]                  call [printf]
    38 0000000B 83C404                          add esp, 4
    39 0000000E E9C3000000                      jmp final
    40                                  
    41                                      start:
    42                                      
    43 00000013 68[39000000]                    push dword n ; citim n
    44 00000018 68[3D000000]                    push dword format_citire
    45 0000001D FF15[00000000]                  call [scanf]
    46 00000023 83C408                          add esp, 4*2
    47                                          
    48 00000026 813D[39000000]FF00-             cmp dword [n], 255 ; verificam daca n incape pe un octet
    48 0000002E 0000               
    49 00000030 77CE                            ja not_octet
    50                                          
    51 00000032 833D[39000000]0A                cmp dword [n], 10 ; cate fisiere creez
    52 00000039 7209                            jb n_mic 
    53 0000003B 7300                            jae n_mare
    54                                          
    55                                          n_mare:
    56 0000003D B90A000000                      mov ecx, 10
    57 00000042 EB08                            jmp fisiere
    58                                          
    59                                          n_mic: 
    60 00000044 8B0D[39000000]                  mov ecx, [n]
    61 0000004A EB00                            jmp fisiere
    62                                  
    63                                          fisiere:
    64                                          
    65                                          repeta_fisier:
    66 0000004C FC                                  cld ; pregatim parcurgerea
    67 0000004D BE[0A000000]                        mov esi, output
    68 00000052 BF[40000000]                        mov edi, nume_fisier
    69                                              
    70 00000057 89CB                                mov ebx, ecx ; salvam ecx
    71                                              
    72 00000059 B906000000                          mov ecx, 6 ; lungimea cuvantului output
    73                                              repeta_output:
    74 0000005E A4                                      movsb
    75 0000005F E2FD                                    loop repeta_output ; nume_fisier = "output"
    76                                                  
    77 00000061 B02D                                mov al, '-'
    78 00000063 AA                                  stosb
    79                                              
    80 00000064 89D8                                mov eax, ebx
    81 00000066 48                                  dec eax 
    82 00000067 83C030                              add eax, '0' ; formam cifra
    83 0000006A AA                                  stosb ; nume_fisier = "output-i"
    84                                              
    85 0000006B B02E                                mov al, '.'
    86 0000006D AA                                  stosb
    87 0000006E B074                                mov al, 't'
    88 00000070 AA                                  stosb
    89 00000071 B078                                mov al, 'x'
    90 00000073 AA                                  stosb
    91 00000074 B074                                mov al, 't'
    92 00000076 AA                                  stosb
    93 00000077 B000                                mov al, 0
    94 00000079 AA                                  stosb ; nume_fisier = "output-i.txt" , 0
    95                                              
    96 0000007A 68[54000000]                        push dword mod_acces ; deschidem fisierul
    97 0000007F 68[40000000]                        push dword nume_fisier
    98 00000084 FF15[00000000]                      call [fopen]
    99 0000008A 83C408                              add esp, 4*2
   100                                              
   101 0000008D 83F800                              cmp eax, 0
   102 00000090 743B                                je skip_fisier
   103 00000092 A3[56000000]                        mov [descriptor], eax ; salvam descriptorul
   104                                              
   105 00000097 FC                                  cld
   106 00000098 BE[00000000]                        mov esi, sir
   107 0000009D BF[10000000]                        mov edi, destinatie
   108                                              
   109 000000A2 89D9                                mov ecx, ebx
   110                                              repeta_rezultat:
   111 000000A4 A4                                      movsb
   112 000000A5 E2FD                                    loop repeta_rezultat
   113                                                  
   114 000000A7 B000                                mov al, 0
   115 000000A9 AA                                  stosb
   116                                                  
   117 000000AA 68[10000000]                        push dword destinatie
   118 000000AF FF35[56000000]                      push dword [descriptor]
   119 000000B5 FF15[00000000]                      call [fprintf]
   120 000000BB 83C408                              add esp, 4*2
   121                                              
   122 000000BE FF35[56000000]                      push dword [descriptor]
   123 000000C4 FF15[00000000]                      call [fclose]
   124 000000CA 83C404                              add esp, 4
   125                                              
   126                                              skip_fisier:
   127                                              
   128 000000CD 89D9                                mov ecx, ebx
   129 000000CF 49                                  dec ecx
   130 000000D0 0F8576FFFFFF                        jnz repeta_fisier
   131                                              
   132                                          
   133                                          final:
   134 000000D6 6A00                            push    dword 0      
   135 000000D8 FF15[00000000]                  call    [exit]       
