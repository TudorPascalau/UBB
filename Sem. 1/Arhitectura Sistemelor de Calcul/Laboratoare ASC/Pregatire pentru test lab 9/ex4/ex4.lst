     1                                  bits 32
     2                                  
     3                                  global start        
     4                                  
     5                                  extern exit, fopen, fprintf, fclose, scanf, strlen  
     6                                  import exit msvcrt.dll
     7                                  import fopen msvcrt.dll
     8                                  import fprintf msvcrt.dll
     9                                  import fclose msvcrt.dll
    10                                  import scanf msvcrt.dll
    11                                  import strlen msvcrt.dll
    12                                  
    13                                  ; Se da un sir de caractere care contine mai multe cuvinte separate prin spatiu (inclusiv ultimul caracter din sir este spatiu)
    14                                  ; Programul va crea pentru fiecare cuvant din sir un nou fisier care va contine nimarul de caractere din cuvant si care va avea ca nume cuvantul respectiv.
    15                                  
    16                                  ; Varianta sir text citit de la tastatura
    17                                  
    18                                  segment data use32 class=data
    19                                      
    20 00000000 00<rept>                    cuvant times 30 db 0
    21 0000001E 257300                      format_citire db "%s", 0
    22 00000021 256400                      format_scriere db "%d", 0
    23                                      
    24 00000024 00<rept>                    nume_fisier times 40 db 0
    25 0000004C 7700                        mod_acces db "w", 0
    26 0000004E FFFFFFFF                    descriptor dd -1
    27                                  
    28                                  segment code use32 class=code
    29                                      start:
    30                                      
    31                                          citeste:
    32                                      
    33 00000000 68[00000000]                    push dword cuvant
    34 00000005 68[1E000000]                    push dword format_citire
    35 0000000A FF15[00000000]                  call [scanf]
    36 00000010 83C408                          add esp, 4*2
    37                                          
    38 00000013 83F801                          cmp eax, 1 ; verificam daca a citit un cuvant
    39 00000016 7572                            jne gata_citire
    40                                          
    41 00000018 68[00000000]                    push dword cuvant
    42 0000001D FF15[00000000]                  call [strlen]
    43 00000023 83C404                          add esp, 4
    44                                          
    45 00000026 89C3                            mov ebx, eax ; salvam lungimea
    46                                          
    47 00000028 FC                              cld
    48 00000029 89D9                            mov ecx, ebx ; ecx !=0
    49 0000002B BE[00000000]                    mov esi, cuvant
    50 00000030 BF[24000000]                    mov edi, nume_fisier
    51                                          
    52                                          repeta:
    53 00000035 A4                                  movsb ; punem literele cuvantului in nume fisier
    54 00000036 E2FD                                loop repeta
    55                                              
    56 00000038 B02E                            mov al, '.'
    57 0000003A AA                              stosb
    58 0000003B B074                            mov al, 't'
    59 0000003D AA                              stosb
    60 0000003E B078                            mov al, 'x'
    61 00000040 AA                              stosb
    62 00000041 B074                            mov al, 't'
    63 00000043 AA                              stosb
    64 00000044 B000                            mov al, 0
    65 00000046 AA                              stosb
    66                                          
    67 00000047 68[4C000000]                    push dword mod_acces ; deschidem fisier
    68 0000004C 68[24000000]                    push dword nume_fisier
    69 00000051 FF15[00000000]                  call [fopen]
    70 00000057 83C408                          add esp, 4*2
    71                                          
    72 0000005A 83F800                          cmp eax, 0 ; verificam daca s-a deschis fisierul
    73 0000005D 7426                            je skip_file
    74                                          
    75 0000005F A3[4E000000]                    mov [descriptor], eax ; salvam descriptor
    76                                          
    77 00000064 53                              push ebx ; scriem in fisier lungimea cuvantului
    78 00000065 68[21000000]                    push dword format_scriere
    79 0000006A FF35[4E000000]                  push dword [descriptor]
    80 00000070 FF15[00000000]                  call [fprintf]
    81 00000076 83C40C                          add esp, 4*3
    82                                          
    83 00000079 FF35[4E000000]                  push dword [descriptor] ; inchidem fisierul
    84 0000007F FF15[00000000]                  call [fclose]
    85                                          
    86                                          skip_file:
    87 00000085 E976FFFFFF                      jmp citeste
    88                                          
    89                                          gata_citire:
    90                                          
    91 0000008A 6A00                            push    dword 0      
    92 0000008C FF15[00000000]                  call    [exit]       
