     1                                  bits 32
     2                                  
     3                                  global start        
     4                                  
     5                                  extern exit               
     6                                  import exit msvcrt.dll    
     7                                  
     8                                  segment data use32 class=data
     9                                  
    10 00000000 3412                            a dw 1234h ; 4660
    11 00000002 5B                              b db 5bh ; 91
    12 00000003 <res 00000004>                  c resd 1 ; FFFFB4B8 4,294,948,024
    13                                          
    14                                          ;Dublucuvantul c se formeaza astfel:
    15                                          ; - bitii 0-2 ai lui c au valoarea 0
    16                                          ; - bitii 3-5 ai lui c au valoarea 1
    17                                          ; - bitii 6-9 ai lui c coincid cu bitii 11-14 ai lui a
    18                                          ; - bitii 10-15 ai lui c coincid cu bitii 1-6 ai lui b
    19                                          ; - bitii 16-31 ai lui c au valoarea 1
    20                                          
    21                                          ; Sa se efectueze in interpretarea fara semn operatia ((a+c)/b+c)*2-a
    22                                  
    23                                  
    24                                  segment code use32 class=code
    25                                      start:
    26                                      
    27 00000000 C705[03000000]3800-             mov dword [c], 11111111111111110000000000111000b ; modificam bitii pentru a coincide cu enuntul
    27 00000008 FFFF               
    28                                          
    29 0000000A 66A1[00000000]                  mov ax, [a] ; modificam din a+4 in a pentru a muta valoarea lui a
    30 00000010 66250078                        and ax, 0111100000000000b ; izolam bitii 11-14
    31 00000014 66C1E805                        shr ax, 5 ; mutam la dreapta cu 5 pozitii
    32 00000018 660905[03000000]                or [c], ax ; renuntam la byte deoarace nu reprezinta dimensiunea corecta
    33 0000001F A0[02000000]                    mov al, [b]
    34 00000024 B400                            mov ah, 0
    35 00000026 6683E07E                        and ax, 07eh ; inlocuim feh cu 7eh pentru a avea masca 0000000001111110 si sa izolam bitii 1-6
    36 0000002A 66C1E009                        shl ax, 9 ; inlocuim al cu ax ; mutam la stanga cu 9 pozitii
    37 0000002E 660905[03000000]                or [c], ax; inlocuim or cu xor pentru a pune in rezultat
    38                                          
    39 00000035 B800000000                      mov eax, 0 ; inlocuim cwde pentru a efectua operatii in interpretare fara semn
    40 0000003A 66A1[00000000]                  mov ax,[a]
    41 00000040 0305[03000000]                  add eax,[c] ; inlocuim ax cu eax pentru a avea dimensiunea corecta
    42 00000046 BA00000000                      mov edx, 0
    43 0000004B 0FB61D[02000000]                movzx ebx, byte[b] ; inlocuim movsz cu movzx pentru a efectua operatii in interpretarea fara semn
    44 00000052 F7F3                            div ebx
    45 00000054 0305[03000000]                  add eax, [c]
    46 0000005A BB02000000                      mov ebx, 2
    47 0000005F F7E3                            mul ebx ; inlocuim imul cu mul pt interpretare fara semn
    48 00000061 93                              xchg eax, ebx ; ebx = eax
    49 00000062 87CA                            xchg ecx, edx ; ecx = edx
    50 00000064 0FB705[00000000]                movzx eax, word[a]
    51 0000006B BA00000000                      mov edx, 0
    52 00000070 29C3                            sub ebx,eax
    53 00000072 19D1                            sbb ecx,edx ; interschimbam sub si sbb
    54                                          
    55 00000074 6A00                            push    dword 0      
    56 00000076 FF15[00000000]                  call    [exit]       
